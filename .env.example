# Copy to .env.local — or just run `npx convex dev`, it writes this for you.
# Without VITE_CONVEX_URL the app runs in demo mode (browser-only data).
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# ---- These go on the CONVEX side (dashboard → Settings → Environment Variables),
# ---- NOT in this file. Listed here so you know what to set:
# AUTH_GOOGLE_ID=...        (Google Cloud Console OAuth client id)
# AUTH_GOOGLE_SECRET=...    (Google Cloud Console OAuth client secret)
# SITE_URL=http://localhost:5173
# JWT_PRIVATE_KEY=...       (set automatically by `npx @convex-dev/auth`)
# JWKS=...                  (set automatically by `npx @convex-dev/auth`)
