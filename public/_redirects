# Cloudflare Pages routing for a laptop-free deploy.
#
# Pages can only rewrite to paths inside this same project, never proxy to another
# host, so the API is forwarded by functions/api/[[path]].js rather than here.
# Rules are matched top to bottom and the first one wins, so specific paths have to
# sit above the single page app catch-all.

# The signed APK is about 50 MB and Pages refuses any asset over 25 MB, so the
# binary lives on the GitHub Release that the build workflow publishes. This rule
# keeps every install link printed before the move pointing somewhere real, and it
# is why scripts/build.mjs no longer copies the APK into dist.
/downloads/JaText-release.apk https://github.com/imzachie/JaText/releases/download/apk-latest/JaText-release.apk 302

# Single page app: /ios/chats, /chats and friends are routes, not files.
# Pages serves a real file in preference to this rule, so assets and the
# apk-version.json manifest next to the site are unaffected.
/*    /index.html   200
